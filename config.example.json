  "spill": {
    "thresholdBytes": 32768
  },
  "inject": {
    "maxChars": 4000,
    "negations": 12,
    "openItems": 25,
    "doneItems": 5,
    "sharedChars": 800
  },
  "limits": {
    "entityJaccardMin": 0.6,
    "entryJaccardMin": 0.5,
    "groundingJaccardMin": 0.6,
    "droppedRatioLimit": 0.3,
    "maxItems": 200
  },
  "lock": {
    "ttlMs": 120000
  }
}
