{
  "_comment": "拷到 ~/.codex/memory/config.json（全局）或 <cwd>/.codex/memory/config.json（项目）。项目层覆盖全局层。",
  "engine": {
    "provider": "ollama",
    "model": "qwen2.5-coder:7b",
    "endpoint": "http://127.0.0.1:11434",
